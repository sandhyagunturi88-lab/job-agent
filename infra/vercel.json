{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace apps/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://jobpilot-uk-api.fly.dev/api/:path*" },
    { "source": "/ws/:path*", "destination": "https://jobpilot-uk-api.fly.dev/ws/:path*" },
    { "source": "/((?!api|ws).*)", "destination": "/index.html" }
  ]
}
