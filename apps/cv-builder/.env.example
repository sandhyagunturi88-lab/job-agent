# Anthropic API key — required for AI generation
ANTHROPIC_API_KEY=
# Model for generation/suggest/polish/extract (JobPilot convention:
# claude-opus-5 default, claude-sonnet-5 as the cheaper option)
ANTHROPIC_MODEL=claude-opus-5

# "true" (default) = everything free, no licence keys needed. Set to "false" at launch.
# When running as the JobPilot plugin, leave beta mode ON — access control and
# billing are handled by the JobPilot app in front of it.
BETA_MODE=true

# Lemon Squeezy (standalone deployments only; not used as a JobPilot plugin)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_CHECKOUT_URL=https://YOURSTORE.lemonsqueezy.com/buy/YOUR-PRODUCT-UUID
LEMONSQUEEZY_WEBHOOK_SECRET=

PORT=3000
