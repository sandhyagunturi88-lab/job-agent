# --- Core ---
APP_ENV=development
API_BASE_URL=http://localhost:8000

# --- Supabase (AWS eu-west-2, London) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Postgres connection string (also used by the LangGraph checkpointer).
# Leave empty in dev to fall back to an in-memory checkpointer.
DATABASE_URL=
# Dev alternative: persist checkpoints to a local SQLite file (ignored when
# DATABASE_URL is set), e.g. ./checkpoints.db
CHECKPOINT_SQLITE_PATH=

# --- LLM (empty key -> deterministic stubs; no Claude calls, no cost) ---
ANTHROPIC_API_KEY=
# claude-opus-5 default; claude-sonnet-5 trades capability for lower cost
ANTHROPIC_MODEL=claude-opus-5

# --- Embeddings (Voyage AI — Anthropic's recommended embeddings partner) ---
# Empty -> deterministic local embedder (dev only, not semantically meaningful)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# --- Queue (Upstash Redis, EU) ---
REDIS_URL=

# --- Ingestion sources (mocked until supplied) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
# What to search the keyed aggregators for (comma-separated)
INGEST_QUERIES=software engineer,python developer
# ATS boards need no keys — just watchlists of company slugs (comma-separated).
# Empty watchlist -> that source serves mock data.
ATS_GREENHOUSE_BOARDS=
ATS_LEVER_COMPANIES=
ATS_WORKABLE_ACCOUNTS=
# DWP Find a Job has no public API; its source stays mocked (see worker/sources/dwp.py).

# --- Billing (empty secret key -> mock provider: the whole upgrade/downgrade
# flow works offline via in-app dev endpoints, no Stripe account needed) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
PRO_PRICE_DISPLAY=£9/month
# Where Stripe redirects back to after checkout/portal (the PWA origin)
APP_BASE_URL=http://localhost:5173

# --- Frontend (Vite; set in apps/web/.env or Vercel) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
