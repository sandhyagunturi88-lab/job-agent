# --- Core ---
APP_ENV=development
API_BASE_URL=http://localhost:8000

# --- Supabase (AWS eu-west-2, London) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Postgres connection string (also used by the LangGraph checkpointer).
# Leave empty in dev to fall back to an in-memory checkpointer.
DATABASE_URL=

# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Embeddings (Voyage AI — Anthropic's recommended embeddings partner) ---
# Empty -> deterministic local embedder (dev only, not semantically meaningful)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# --- Queue (Upstash Redis, EU) ---
REDIS_URL=

# --- Ingestion sources (mocked until supplied) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
# What to search the keyed aggregators for (comma-separated)
INGEST_QUERIES=software engineer,python developer
# ATS boards need no keys — just watchlists of company slugs (comma-separated).
# Empty watchlist -> that source serves mock data.
ATS_GREENHOUSE_BOARDS=
ATS_LEVER_COMPANIES=
ATS_WORKABLE_ACCOUNTS=
# DWP Find a Job has no public API; its source stays mocked (see worker/sources/dwp.py).

# --- Billing (phase 6) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# --- Frontend (Vite; set in apps/web/.env or Vercel) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
